# TinyOTA Device Agent — configuration
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# All values can also be passed as environment variables directly.

# ── Required ────────────────────────────────────────────────────────────────

# TinyOTA server base URL
FOTA_SERVER_URL=https://api.tinyota.xyz

# Registration token from the Device Model page in the TinyOTA console
FOTA_REGISTRATION_TOKEN=your-registration-token-here

# ── Device identity ──────────────────────────────────────────────────────────

# Unique serial number for this unit (MAC address, hardware ID, etc.)
# Defaults to "sim-001" if not set
FOTA_UNIT_SERIAL=sim-001

# Current firmware version running on this device
FOTA_CURRENT_VERSION=1.0.0

# ── Update behaviour ─────────────────────────────────────────────────────────

# How often to check for updates (seconds). Default: 3600 (1 hour)
FOTA_CHECK_INTERVAL=3600

# Reported free RAM in KB (used by server to decide delta vs full update)
FOTA_RAM_FREE_KB=512

# Reported free storage in KB
FOTA_STORAGE_FREE_KB=4096

# Path to persist the device token across reboots
FOTA_TOKEN_FILE=.device_token

# ── Retry / backoff ──────────────────────────────────────────────────────────

# Maximum retry attempts per operation (register / check / download)
FOTA_RETRY_MAX=4

# Base delay in seconds for exponential backoff (doubles each attempt)
FOTA_RETRY_BASE_DELAY=5.0

# Maximum backoff delay in seconds
FOTA_RETRY_MAX_DELAY=300.0
