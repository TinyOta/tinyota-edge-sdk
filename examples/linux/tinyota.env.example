# Copy to /etc/tinyota/tinyota.env (chmod 600). Read by tinyota-agent.service.
FOTA_SERVER_URL=https://api.tinyota.xyz
FOTA_REGISTRATION_TOKEN=paste-registration-token
# Stable per device: e.g. the output of `cat /etc/machine-id`
FOTA_UNIT_SERIAL=change-me
# Used only until the first update writes FOTA_VERSION_FILE
FOTA_CURRENT_VERSION=1.0.0
FOTA_VERSION_FILE=/var/lib/tinyota/version
FOTA_TOKEN_FILE=/var/lib/tinyota/device_token
FOTA_PUBLIC_KEY_PEM=/etc/tinyota/tinyota_pubkey.pem
FOTA_INSTALL_CMD=/usr/local/lib/tinyota/install-app.sh
FOTA_CHECK_INTERVAL=3600
# The Python agent can apply DELTA patches; keep 0 to always get FULL.
FOTA_RAM_FREE_KB=0
